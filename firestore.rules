rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSupplier() {
      return isAuthenticated() && (
        request.auth.token.role == 'supplier' || 
        resource.data.supplierId == request.auth.uid
      );
    }

    // Public catalog collections: readable by anyone (or authenticated demo users)
    // Authenticated users can submit new scrap materials and updates
    match /materials/{materialId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Artworks: public read, creators can create and edit only their own artworks
    match /artworks/{artworkId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.creatorEmail == request.auth.token.email
      );
    }

    // Activities: public read, append-only for authenticated activity events
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Users collection: users can read and edit only their own profile;
    // suppliers can record material provisions
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSupplier());
      allow delete: if false;
    }

    // Orders collection:
    // - Creators can create orders and read their own orders
    // - Suppliers can view and update the status of orders addressed to them
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.creatorEmail == request.auth.token.email ||
        resource.data.supplierId == request.auth.uid ||
        request.auth.token.role == 'supplier'
      );
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.creatorEmail == request.auth.token.email
      );
      allow update: if isAuthenticated() && (
        // Only suppliers can advance order delivery status
        resource.data.supplierId == request.auth.uid ||
        request.auth.token.role == 'supplier' ||
        // Creators can only update their own notes or cancel before confirmation
        (resource.data.creatorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'status']))
      );
      allow delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
