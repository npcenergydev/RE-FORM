rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if uploaded file is a valid image under 5 MB
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for gallery artworks; authenticated uploads must be images under 5 MB
    match /artworks/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
    }

    // Scanned scrap photos
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
    }

    // User profile avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidImage();
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
